[Unit]
Description=LEGO Pi Qwen local router warm-up
After=ollama.service
Requires=ollama.service

[Service]
Type=oneshot
User=ty
ExecStart=/usr/bin/curl -fsS --max-time 45 http://127.0.0.1:11434/api/generate -H Content-Type:application/json -d {"model":"qwen2.5:1.5b","prompt":"Return JSON only: {\\"action\\":\\"UNKNOWN\\"}","stream":false,"format":"json","keep_alive":"30m","options":{"temperature":0,"num_predict":2}}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
